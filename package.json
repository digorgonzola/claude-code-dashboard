{
  "name": "claude-code-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A live dashboard for every Claude Code session running on this machine — real session discovery, status you can trust, cost, and PR state. Built on the Organic design system.",
  "license": "Apache-2.0",
  "author": "Stefan Hattrell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digorgonzola/claude-code-dashboard.git"
  },
  "homepage": "https://github.com/digorgonzola/claude-code-dashboard#readme",
  "bugs": {
    "url": "https://github.com/digorgonzola/claude-code-dashboard/issues"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node scripts/check.mjs",
    "test": "node --test '.github/**/*.test.cjs'"
  }
}
